{
  "name": "foolscap",
  "productName": "foolscap",
  "version": "1.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "An inbox for your coding agents and assistants. Lives in the tray, tells you the moment one needs you, and sends the next prompt only when the tests pass.",
  "main": "app/main/index.mjs",
  "author": "N Divij",
  "engines": {
    "node": ">=22.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N-45div/foolscap.git"
  },
  "keywords": [
    "claude-code",
    "codex",
    "acp",
    "coding-agents",
    "agent-inbox",
    "tray",
    "local-first"
  ],
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config app/renderer/vite.config.ts",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "dev.foolscap.app",
    "productName": "foolscap",
    "copyright": "Copyright © 2026 N Divij",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "app/main/**",
      "app/preload.cjs",
      "dist/renderer/**",
      "server/**",
      "!server/**/*.d.mts",
      "package.json"
    ],
    "asarUnpack": [
      "server/permission-mcp.mjs"
    ],
    "win": {
      "target": [
        "nsis",
        "appx"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "foolscap"
    },
    "appx": {
      "applicationId": "foolscap",
      "displayName": "foolscap",
      "identityName": "[YOUR STORE IDENTITY NAME]",
      "publisher": "[YOUR STORE PUBLISHER ID]",
      "publisherDisplayName": "N Divij"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "category": "Development",
      "synopsis": "An inbox for your coding agents",
      "maintainer": "N Divij"
    }
  },
  "homepage": "https://foolscap-topaz.vercel.app"
}
